:root {
    --background: #0b0f19;
    --interface: #151b2b;
    --primary: #2563eb;
    --secondary: #3b82f6;
    --text: #ffffff;
    --text-muted: #aab2c0;
    --border: #26324a;
}
body {
    background-color: var(--background);
    color: var(--text);
}

.product {
    background-color: var(--interface);
    border: 1px solid var(--border);
}

button {
    background-color: var(--primary);
    color: var(--text);
}
